# ===== OPTION 1: Cookie posting (FREE, recommended for this workflow) =====
# From a logged-in x.com session for the ACCOUNT THAT WILL POST (@theforexclue).
# DevTools -> Application -> Cookies -> x.com -> copy "auth_token" and "ct0"
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Any extra cookies from the session (paste the rest of the cookie header, optional)
TWITTER_EXTRA_COOKIES=

# Human pacing: random pause before every action (milliseconds)
HUMAN_PAUSE_MIN_MS=6000
HUMAN_PAUSE_MAX_MS=18000

# ===== OPTION 2: Official X API keys (PAID, pay-per-use) =====
# Leave the two cookie vars above EMPTY to use these instead.
# Twitter / X - OAuth 1.0a user context (required to post tweets)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Discord incoming webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
